name: Build APK
on:
  workflow_dispatch:
  push:
    branches: [main, master]
env:
  SINGBOX_TAG: v1.11.4
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Unpack project if uploaded as zip
        run: |
          if [ -f vpnhub.zip ]; then unzip -o vpnhub.zip -d . ; fi
          ls -la
      - uses: actions/setup-java@v4
        with: { distribution: temurin, java-version: '17' }
      - uses: actions/setup-go@v5
        with: { go-version: '1.23' }
      - name: Build libbox (sing-box core for Android)
        run: |
          git clone --depth 1 --branch "$SINGBOX_TAG" https://github.com/SagerNet/sing-box.git /tmp/sing-box
          cd /tmp/sing-box
          GM=$(grep -o 'gomobile/cmd/gomobile@v[0-9.]*' Makefile | head -1)
          GB=$(grep -o 'gomobile/cmd/gobind@v[0-9.]*' Makefile | head -1)
          go install -v github.com/sagernet/$GM
          go install -v github.com/sagernet/$GB
          export PATH="$PATH:$(go env GOPATH)/bin"
          export ANDROID_HOME="${ANDROID_SDK_ROOT:-$ANDROID_HOME}"
          echo "NDK: $ANDROID_NDK_HOME"
          go run ./cmd/internal/build_libbox -target android
          mkdir -p "$GITHUB_WORKSPACE/app/libs"
          cp libbox.aar "$GITHUB_WORKSPACE/app/libs/libbox.aar"
      - uses: gradle/actions/setup-gradle@v4
        with: { gradle-version: '8.9' }
      - name: Build APK
        run: gradle assembleDebug --no-daemon --stacktrace
      - uses: actions/upload-artifact@v4
        with:
          name: VpnHub-apk
          path: app/build/outputs/apk/debug/*.apk
